# Required: create your own Fish Audio API key in the Fish Audio dashboard.
# Keep the real value in .env.local; never use a NEXT_PUBLIC_ prefix.
FISH_AUDIO_API_KEY=

# Created and saved by: node scripts/setup-fish-agent.mjs
FISH_AUDIO_AGENT_ID=

# Created and saved by: node scripts/setup-native-voice.mjs
FISH_AUDIO_NATIVE_AGENT_ID=
FISH_AUDIO_DRAMA_AGENT_ID=

# Optional: an existing Fish Audio voice you own or are authorised to use.
# Enables personal-voice playback in the Translate tab.
FISH_AUDIO_TRANSLATION_VOICE_ID=

# Stripe billing. Use a restricted key (rk_) from a Stripe sandbox while developing.
STRIPE_SECRET_KEY=
# Printed by `stripe listen` locally, or shown on the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the subscription plan, monthly and annual.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Neon Postgres connection string for the naga-vox project (copy from the Neon console).
DATABASE_URL=

# Neon Auth sign-in for the naga-vox project. The base URL comes from the Neon console or provisioning output.
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
